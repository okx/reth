              "content": "//! AsyncRocksStore: in-memory reads + async RocksDB persistence.\n//!\n//! Combines the best of FlatFile (fast BTreeMap reads) and RocksDB (production-grade\n//! crash recovery via WAL). Writes update the in-memory state synchronously (microseconds),\n//! then send updates to a background thread for async RocksDB persistence.\n//!\n//! ## Design\n//!\n//! - **Reads**: Served from in-memory `BTreeMap` (identical to `FlatFileStore`).\n//! - **Writes**: Update in-memory state synchronously, then dispatch a `WriteJob` to\n//!   a background thread that writes a `WriteBatch` to RocksDB.\n//! - **Cold start**: On `new()`, the full state is loaded from RocksDB into memory.\n//! - **Shutdown**: `Drop` sends a `Shutdown` job and joins the writer thread, ensuring\n//!   all pending writes are flushed before the store is dropped.\n//!\n//! ## Performance\n//!\n//! - Delta phase reads from in-memory BTreeMap (~27ms) instead of RocksDB (~105ms).\n//! - I/O on the critical path is ~0ms (background write), vs 37ms synchronous RocksDB.\n//! - Expected ~120ms/block vs 250ms for synchronous RocksDB.\n\nuse rocksdb::{\n    BlockBasedOptions, Cache, ColumnFamilyDescriptor, Options, WriteBatch, WriteOptions, DB,\n};\nuse salt::{\n    constant::default_commitment,\n    traits::{StateReader, TrieReader},\n    types::*,\n    StateUpdates, TrieUpdates,\n};\nuse std::{\n    collections::{BTreeMap, HashMap},\n    ops::{Range, RangeInclusive},\n    path::Path,\n    sync::{\n        mpsc::{self, Sender},\n        Arc, Mutex, RwLock,\n    },\n    time::{Duration, Instant},\n};\n\nconst CF_STATE: \u0026str = \"salt_state\";\nconst CF_TRIE: \u0026str = \"salt_trie\";\nconst CF_INDEX: \u0026str = \"salt_index\";\n\n/// 512MB block cache — used during cold start loading and as RocksDB internal cache.\nconst BLOCK_CACHE_SIZE: usize = 512 * 1024 * 1024;\n\nfn bytes_to_salt_value(bytes: \u0026[u8]) -\u003e SaltValue {\n    let mut data = [0u8; MAX_SALT_VALUE_BYTES];\n    let len = bytes.len().min(MAX_SALT_VALUE_BYTES);\n    data[..len].copy_from_slice(\u0026bytes[..len]);\n    SaltValue { data }\n}\n\n/// Write statistics for a single block's persistence.\n#[derive(Debug)]\npub struct WriteStats {\n    /// Number of state entries written.\n    pub entries: usize,\n    /// Bytes written.\n    pub bytes_written: usize,\n    /// Time to update in-memory state (not disk time — disk writes are async).\n    pub persist_duration: Duration,\n}\n\n/// In-memory state cache (same layout as FlatFileStore).\n#[derive(Default, Clone, Debug)]\nstruct StateStore {\n    kvs: BTreeMap\u003cSaltKey, SaltValue\u003e,\n    used_slots: HashMap\u003cBucketId, u64\u003e,\n}\n\n/// A job sent to the background writer thread.\nenum WriteJob {\n    /// Combined state + trie update to write to RocksDB.\n    StateAndTrie { state: Vec\u003cStateEntry\u003e, trie: Vec\u003c(u64, [u8; 64])\u003e },\n    /// Signals the writer thread to exit.\n    Shutdown,\n}\n\n/// A single state entry serialized for the background writer.\nstruct StateEntry {\n    key_bytes: [u8; 8],\n    /// `Some(data[..data_len])` for upsert, `None` for delete.\n    value: Option\u003c(usize, [u8; MAX_SALT_VALUE_BYTES])\u003e,\n    /// Reverse index operation: insert plain_key, delete plain_key, or no-op.\n    index_op: IndexOp,\n}\n\nenum IndexOp {\n    Insert { plain_key: Vec\u003cu8\u003e, salt_key_bytes: [u8; 8] },\n    Delete { plain_key: Vec\u003cu8\u003e },\n    Noop,\n}\n\n/// Opaque snapshot of an [`AsyncRocksStore`]'s in-memory state, used for fast reset\n/// in benchmarks.\n#[derive(Debug)]\npub struct AsyncRocksSnapshot {\n    state: StateStore,\n    trie: BTreeMap\u003cNodeId, CommitmentBytes\u003e,\n}\n\n/// AsyncRocksStore: in-memory reads with background RocksDB persistence.\n///\n/// All reads are served from in-memory BTreeMaps (same speed as FlatFile/MemStore).\n/// All writes update memory synchronously, then are dispatched to a background thread\n/// for async RocksDB persistence.\npub struct AsyncRocksStore {\n    /// In-memory state (reads served from here).\n    state: RwLock\u003cStateStore\u003e,\n    /// In-memory trie commitments.\n    trie: RwLock\u003cBTreeMap\u003cNodeId, CommitmentBytes\u003e\u003e,\n    /// RocksDB handle (owned by background writer via Arc).\n    db: Arc\u003cDB\u003e,\n    /// Block cache — must outlive DB.\n    _block_cache: Cache,\n    /// Channel sender for background write jobs.\n    write_tx: Mutex\u003cOption\u003cSender\u003cWriteJob\u003e\u003e\u003e,\n    /// Handle for the background writer thread.\n    writer_handle: Mutex\u003cOption\u003cstd::thread::JoinHandle\u003c()\u003e\u003e\u003e,\n}\n\nimpl std::fmt::Debug for AsyncRocksStore {\n    fn fmt(\u0026self, f: \u0026mut std::fmt::Formatter\u003c'_\u003e) -\u003e std::fmt::Result {\n        f.debug_struct(\"AsyncRocksStore\").finish()\n    }\n}\n\nimpl AsyncRocksStore {\n    /// Opens or creates an AsyncRocksStore at the given path.\n    ///\n    /// On cold start, loads all state and trie data from RocksDB into memory.\n    /// Spawns a background writer thread for async persistence.\n    pub fn new(path: \u0026Path) -\u003e Result\u003cSelf, rocksdb::Error\u003e {\n        let block_cache = Cache::new_lru_cache(BLOCK_CACHE_SIZE);\n\n        let mut table_opts = BlockBasedOptions::default();\n        table_opts.set_block_cache(\u0026block_cache);\n        table_opts.set_bloom_filter(10.0, false);\n\n        let mut opts = Options::default();\n        opts.create_if_missing(true);\n        opts.create_missing_column_families(true);\n        opts.set_write_buffer_size(64 * 1024 * 1024);\n        opts.set_max_write_buffer_number(3);\n        opts.set_allow_mmap_reads(true);\n        opts.set_block_based_table_factory(\u0026table_opts);\n\n        let mut cf_state_opts = Options::default();\n        cf_state_opts.set_block_based_table_factory(\u0026table_opts);\n\n        let mut cf_trie_opts = Options::default();\n        cf_trie_opts.set_block_based_table_factory(\u0026table_opts);\n\n        let mut cf_index_opts = Options::default();\n        cf_index_opts.set_block_based_table_factory(\u0026table_opts);\n\n        let cf_descriptors = vec![\n            ColumnFamilyDescriptor::new(CF_STATE, cf_state_opts),\n            ColumnFamilyDescriptor::new(CF_TRIE, cf_trie_opts),\n            ColumnFamilyDescriptor::new(CF_INDEX, cf_index_opts),\n        ];\n\n        let db = Arc::new(DB::open_cf_descriptors(\u0026opts, path, cf_descriptors)?);\n\n        // Load state + trie from RocksDB into memory (cold start).\n        let (state_store, trie_map) = Self::load_from_rocksdb(\u0026db)?;\n\n        // Spawn background writer thread.\n        let (write_tx, write_rx) = mpsc::channel::\u003cWriteJob\u003e();\n        let db_clone = Arc::clone(\u0026db);\n        let writer_handle = std::thread::Builder::new()\n            .name(\"salt-async-rocks-writer\".into())\n            .spawn(move || {\n                Self::writer_loop(db_clone, write_rx);\n            })\n            .expect(\"failed to spawn async rocks writer thread\");\n\n        Ok(Self {\n            state: RwLock::new(state_store),\n            trie: RwLock::new(trie_map),\n            db,\n            _block_cache: block_cache,\n            write_tx: Mutex::new(Some(write_tx)),\n            writer_handle: Mutex::new(Some(writer_handle)),\n        })\n    }\n\n    /// Loads all state and trie data from RocksDB into in-memory BTreeMaps.\n    ///\n    /// This is a one-time cost on startup: iterate all entries in CF_STATE and CF_TRIE,\n    /// populating the in-memory maps. For 200K accounts (~2.2M entries), this takes\n    /// a few seconds.\n    fn load_from_rocksdb(\n        db: \u0026DB,\n    ) -\u003e Result\u003c(StateStore, BTreeMap\u003cNodeId, CommitmentBytes\u003e), rocksdb::Error\u003e {\n        let mut state_store = StateStore::default();\n\n        // Load CF_STATE\n        let cf_state = db.cf_handle(CF_STATE).expect(\"CF_STATE must exist\");\n        let iter = db.iterator_cf(\u0026cf_state, rocksdb::IteratorMode::Start);\n        for item in iter {\n            let (k, v) = item?;\n            if k.len() == 8 {\n                let key_u64 = u64::from_be_bytes(k.as_ref().try_into().unwrap());\n                let salt_key = SaltKey(key_u64);\n                let salt_value = bytes_to_salt_value(\u0026v);\n\n                // Compute used_slots from data entries.\n                if !salt_key.is_in_meta_bucket() {\n                    let count = state_store.used_slots.entry(salt_key.bucket_id()).or_insert(0);\n                    *count += 1;\n                }\n\n                state_store.kvs.insert(salt_key, salt_value);\n            }\n        }\n\n        // Load CF_TRIE\n        let mut trie_map = BTreeMap::new();\n        let cf_trie = db.cf_handle(CF_TRIE).expect(\"CF_TRIE must exist\");\n        let iter = db.iterator_cf(\u0026cf_trie, rocksdb::IteratorMode::Start);\n        for item in iter {\n            let (k, v) = item?;\n            if k.len() == 8 \u0026\u0026 v.len() == 64 {\n                let node_id = u64::from_be_bytes(k.as_ref().try_into().unwrap());\n                let mut commitment = [0u8; 64];\n                commitment.copy_from_slice(\u0026v);\n                trie_map.insert(node_id, commitment);\n            }\n        }\n\n        Ok((state_store, trie_map))\n    }\n\n    /// Background writer loop: receives WriteJobs and writes to RocksDB.\n    fn writer_loop(db: Arc\u003cDB\u003e, rx: mpsc::Receiver\u003cWriteJob\u003e) {\n        for job in rx {\n            match job {\n                WriteJob::StateAndTrie { state, trie } =\u003e {\n                    let cf_state = db.cf_handle(CF_STATE).expect(\"CF_STATE must exist\");\n                    let cf_trie = db.cf_handle(CF_TRIE).expect(\"CF_TRIE must exist\");\n                    let cf_index = db.cf_handle(CF_INDEX).expect(\"CF_INDEX must exist\");\n\n                    let mut batch = WriteBatch::default();\n\n                    // State entries + reverse index\n                    for entry in state {\n                        // Index maintenance\n                        match entry.index_op {\n                            IndexOp::Insert { plain_key, salt_key_bytes } =\u003e {\n                                batch.put_cf(\u0026cf_index, \u0026plain_key, \u0026salt_key_bytes);\n                            }\n                            IndexOp::Delete { plain_key } =\u003e {\n                                batch.delete_cf(\u0026cf_index, \u0026plain_key);\n                            }\n                            IndexOp::Noop =\u003e {}\n                        }\n\n                        // State data\n                        match entry.value {\n                            Some((data_len, data)) =\u003e {\n                                batch.put_cf(\u0026cf_state, \u0026entry.key_bytes, \u0026data[..data_len]);\n                            }\n                            None =\u003e {\n                                batch.delete_cf(\u0026cf_state, \u0026entry.key_bytes);\n                            }\n                        }\n                    }\n\n                    // Trie entries\n                    for (node_id, commitment) in trie {\n                        batch.put_cf(\u0026cf_trie, \u0026node_id.to_be_bytes(), \u0026commitment);\n                    }\n\n                    // Write without forced fsync — WAL provides crash safety.\n                    if let Err(e) = db.write_opt(batch, \u0026WriteOptions::default()) {\n                        tracing::error!(target: \"salt::async_rocks\", %e, \"background RocksDB write failed\");\n                    }\n                }\n                WriteJob::Shutdown =\u003e break,\n            }\n        }\n    }\n\n    /// Captures a snapshot of the in-memory state + trie for fast restore in benchmarks.\n    pub fn snapshot(\u0026self) -\u003e AsyncRocksSnapshot {\n        AsyncRocksSnapshot {\n            state: self.state.read().unwrap().clone(),\n            trie: self.trie.read().unwrap().clone(),\n        }\n    }\n\n    /// Restores from a snapshot (in-memory only — does NOT update RocksDB).\n    pub fn restore(\u0026self, snap: \u0026AsyncRocksSnapshot) {\n        *self.state.write().unwrap() = snap.state.clone();\n        *self.trie.write().unwrap() = snap.trie.clone();\n    }\n\n    /// Applies state updates: updates in-memory state synchronously, then dispatches\n    /// a background write to RocksDB.\n    pub fn update_state(\u0026self, updates: StateUpdates) -\u003e Result\u003cWriteStats, rocksdb::Error\u003e {\n        let t0 = Instant::now();\n        let num_entries = updates.data.len();\n        let mut bytes = 0usize;\n        let mut state_entries = Vec::with_capacity(num_entries);\n\n        // Update in-memory state and prepare background write entries.\n        let mut state = self.state.write().unwrap();\n        for (key, (old_value, new_value)) in updates.data {\n            // Update in-memory slot counts.\n            if !key.is_in_meta_bucket() {\n                let delta: i64 = match (old_value.is_some(), new_value.is_some()) {\n                    (false, true) =\u003e 1,\n                    (true, false) =\u003e -1,\n                    _ =\u003e 0,\n                };\n                if delta != 0 {\n                    let count = state.used_slots.entry(key.bucket_id()).or_insert(0);\n                    *count = (*count as i64 + delta).max(0) as u64;\n                }\n            }\n\n            let key_bytes = key.0.to_be_bytes();\n\n            // Determine index operation.\n            let index_op = if !key.is_in_meta_bucket() {\n                match (\u0026old_value, \u0026new_value) {\n                    (None, Some(new_val)) =\u003e IndexOp::Insert {\n                        plain_key: new_val.key().to_vec(),\n                        salt_key_bytes: key_bytes,\n                    },\n                    (Some(old_val), None) =\u003e {\n                        IndexOp::Delete { plain_key: old_val.key().to_vec() }\n                    }\n                    _ =\u003e IndexOp::Noop,\n                }\n            } else {\n                IndexOp::Noop\n            };\n\n            // Prepare value for background write.\n            let value = match \u0026new_value {\n                Some(val) =\u003e {\n                    let data_len = val.data_len();\n                    bytes += 8 + data_len;\n                    Some((data_len, val.data))\n                }\n                None =\u003e {\n                    bytes += 8;\n                    None\n                }\n            };\n\n            // Update in-memory state.\n            match new_value {\n                Some(val) =\u003e state.kvs.insert(key, val),\n                None =\u003e state.kvs.remove(\u0026key),\n            };\n\n            state_entries.push(StateEntry { key_bytes, value, index_op });\n        }\n        drop(state);\n\n        let persist_duration = t0.elapsed();\n\n        // Dispatch to background writer.\n        if let Some(tx) = self.write_tx.lock().unwrap().as_ref() {\n            let _ = tx.send(WriteJob::StateAndTrie { state: state_entries, trie: Vec::new() });\n        }\n\n        Ok(WriteStats { entries: num_entries, bytes_written: bytes, persist_duration })\n    }\n\n    /// Applies trie updates: updates in-memory trie synchronously, then dispatches\n    /// a background write to RocksDB.\n    ///\n    /// Returns the number of trie entries written.\n    pub fn update_trie(\u0026self, updates: TrieUpdates) -\u003e Result\u003cusize, rocksdb::Error\u003e {\n        let mut trie_entries = Vec::with_capacity(updates.len());\n        let mut count = 0;\n\n        // Update in-memory trie.\n        let mut trie = self.trie.write().unwrap();\n        for (node_id, (_, new_commitment)) in updates {\n            trie.insert(node_id, new_commitment);\n            trie_entries.push((node_id, new_commitment));\n            count += 1;\n        }\n        drop(trie);\n\n        // Dispatch to background writer.\n        if let Some(tx) = self.write_tx.lock().unwrap().as_ref() {\n            let _ = tx.send(WriteJob::StateAndTrie { state: Vec::new(), trie: trie_entries });\n        }\n\n        Ok(count)\n    }\n\n    /// Applies state and trie updates atomically: updates in-memory state synchronously,\n    /// then dispatches a single background write to RocksDB.\n    ///\n    /// Returns `(WriteStats, trie_entries_written)`.\n    pub fn update_state_and_trie(\n        \u0026self,\n        state_updates: StateUpdates,\n        trie_updates: TrieUpdates,\n    ) -\u003e Result\u003c(WriteStats, usize), rocksdb::Error\u003e {\n        let t0 = Instant::now();\n        let num_state_entries = state_updates.data.len();\n        let mut bytes = 0usize;\n        let mut bg_state_entries = Vec::with_capacity(num_state_entries);\n\n        // Update in-memory state.\n        let mut state = self.state.write().unwrap();\n        for (key, (old_value, new_value)) in state_updates.data {\n            if !key.is_in_meta_bucket() {\n                let delta: i64 = match (old_value.is_some(), new_value.is_some()) {\n                    (false, true) =\u003e 1,\n                    (true, false) =\u003e -1,\n                    _ =\u003e 0,\n                };\n                if delta != 0 {\n                    let count = state.used_slots.entry(key.bucket_id()).or_insert(0);\n                    *count = (*count as i64 + delta).max(0) as u64;\n                }\n            }\n\n            let key_bytes = key.0.to_be_bytes();\n\n            let index_op = if !key.is_in_meta_bucket() {\n                match (\u0026old_value, \u0026new_value) {\n                    (None, Some(new_val)) =\u003e IndexOp::Insert {\n                        plain_key: new_val.key().to_vec(),\n                        salt_key_bytes: key_bytes,\n                    },\n                    (Some(old_val), None) =\u003e {\n                        IndexOp::Delete { plain_key: old_val.key().to_vec() }\n                    }\n                    _ =\u003e IndexOp::Noop,\n                }\n            } else {\n                IndexOp::Noop\n            };\n\n            let value = match \u0026new_value {\n                Some(val) =\u003e {\n                    let data_len = val.data_len();\n                    bytes += 8 + data_len;\n                    Some((data_len, val.data))\n                }\n                None =\u003e {\n                    bytes += 8;\n                    None\n                }\n            };\n\n            match new_value {\n                Some(val) =\u003e state.kvs.insert(key, val),\n                None =\u003e state.kvs.remove(\u0026key),\n            };\n\n            bg_state_entries.push(StateEntry { key_bytes, value, index_op });\n        }\n        drop(state);\n\n        // Update in-memory trie.\n        let mut bg_trie_entries = Vec::with_capacity(trie_updates.len());\n        let mut trie_count = 0;\n        let mut trie = self.trie.write().unwrap();\n        for (node_id, (_, new_commitment)) in trie_updates {\n            trie.insert(node_id, new_commitment);\n            bg_trie_entries.push((node_id, new_commitment));\n            trie_count += 1;\n        }\n        drop(trie);\n\n        let persist_duration = t0.elapsed();\n\n        // Dispatch single combined job to background writer.\n        if let Some(tx) = self.write_tx.lock().unwrap().as_ref() {\n            let _ = tx.send(WriteJob::StateAndTrie {\n                state: bg_state_entries,\n                trie: bg_trie_entries,\n            });\n        }\n\n        Ok((\n            WriteStats { entries: num_state_entries, bytes_written: bytes, persist_duration },\n            trie_count,\n        ))\n    }\n\n    /// Blocks until all pending background writes are flushed to RocksDB.\n    ///\n    /// Sends a shutdown signal to the writer thread and waits for it to finish\n    /// processing all queued jobs. After this call, the store is no longer usable\n    /// for writes — a new writer thread is NOT spawned.\n    pub fn flush(\u0026self) {\n        // Take the sender to drop it after sending Shutdown — this ensures the\n        // writer thread's recv loop exits after processing all queued jobs.\n        let tx = self.write_tx.lock().unwrap().take();\n        if let Some(tx) = tx {\n            let _ = tx.send(WriteJob::Shutdown);\n            // Dropping tx here closes the channel after Shutdown is sent.\n        }\n        let handle = self.writer_handle.lock().unwrap().take();\n        if let Some(handle) = handle {\n            let _ = handle.join();\n        }\n    }\n\n    /// Logs bucket used-slot distribution (same as RocksSaltStore).\n    pub fn log_bucket_load_stats(\u0026self) {\n        let state = self.state.read().unwrap();\n        let used: Vec\u003cu64\u003e = state.used_slots.values().copied().filter(|\u0026u| u \u003e 0).collect();\n        drop(state);\n        if used.is_empty() {\n            eprintln!(\"  [SALT] bucket load: 0 buckets with data\");\n            return;\n        }\n        let n = used.len();\n        let max_used = *used.iter().max().unwrap_or(\u00260);\n        let sum: u64 = used.iter().sum();\n        let mean = sum as f64 / n as f64;\n        let mut sorted = used.clone();\n        sorted.sort_unstable();\n        let p50 = sorted[n / 2];\n        let idx99 = (n * 99) / 100;\n        let p99 = sorted.get(idx99).copied().unwrap_or(p50);\n        eprintln!(\n            \"  [SALT] bucket load: {} buckets with data, used_slots max={} mean={:.1} p50={} p99={}\",\n            n, max_used, mean, p50, p99\n        );\n    }\n}\n\nimpl Drop for AsyncRocksStore {\n    fn drop(\u0026mut self) {\n        // Ensure background writer is shut down cleanly.\n        let tx = self.write_tx.lock().unwrap().take();\n        if let Some(tx) = tx {\n            let _ = tx.send(WriteJob::Shutdown);\n        }\n        let handle = self.writer_handle.lock().unwrap().take();\n        if let Some(handle) = handle {\n            let _ = handle.join();\n        }\n    }\n}\n\nimpl StateReader for AsyncRocksStore {\n    type Error = SaltError;\n\n    fn value(\u0026self, key: SaltKey) -\u003e Result\u003cOption\u003cSaltValue\u003e, Self::Error\u003e {\n        Ok(self.state.read().unwrap().kvs.get(\u0026key).cloned())\n    }\n\n    fn entries(\n        \u0026self,\n        range: RangeInclusive\u003cSaltKey\u003e,\n    ) -\u003e Result\u003cVec\u003c(SaltKey, SaltValue)\u003e, Self::Error\u003e {\n        Ok(self.state.read().unwrap().kvs.range(range).map(|(k, v)| (*k, v.clone())).collect())\n    }\n\n    fn metadata(\u0026self, bucket_id: BucketId) -\u003e Result\u003cBucketMeta, Self::Error\u003e {\n        let key = bucket_metadata_key(bucket_id);\n        let state = self.state.read().unwrap();\n        let mut meta = match state.kvs.get(\u0026key) {\n            Some(v) =\u003e v.try_into()?,\n            None =\u003e BucketMeta::default(),\n        };\n        meta.used = Some(*state.used_slots.get(\u0026bucket_id).unwrap_or(\u00260));\n        Ok(meta)\n    }\n\n    fn bucket_used_slots(\u0026self, bucket_id: BucketId) -\u003e Result\u003cu64, Self::Error\u003e {\n        if !is_valid_data_bucket(bucket_id) {\n            return Ok(0);\n        }\n        Ok(*self.state.read().unwrap().used_slots.get(\u0026bucket_id).unwrap_or(\u00260))\n    }\n\n    /// O(1) lookup via RocksDB's reverse index (`CF_INDEX`).\n    ///\n    /// Unlike the in-memory-only FlatFileStore, AsyncRocksStore maintains the CF_INDEX\n    /// for fast `plain_value_fast` lookups (same as RocksSaltStore).\n    fn plain_value_fast(\u0026self, plain_key: \u0026[u8]) -\u003e Result\u003cSaltKey, Self::Error\u003e {\n        let cf = self.db.cf_handle(CF_INDEX).expect(\"CF_INDEX must exist\");\n        match self.db.get_cf(\u0026cf, plain_key) {\n            Ok(Some(bytes)) if bytes.len() == 8 =\u003e {\n                let arr: [u8; 8] = bytes[..8].try_into().expect(\"length checked above\");\n                Ok(SaltKey(u64::from_be_bytes(arr)))\n            }\n            _ =\u003e Err(SaltError::UnsupportedOperation {\n                operation: \"AsyncRocksStore::plain_value_fast: key not in index\",\n            }),\n        }\n    }\n}\n\nimpl TrieReader for AsyncRocksStore {\n    type Error = SaltError;\n\n    fn commitment(\u0026self, node_id: NodeId) -\u003e Result\u003cCommitmentBytes, Self::Error\u003e {\n        Ok(self\n            .trie\n            .read()\n            .unwrap()\n            .get(\u0026node_id)\n            .copied()\n            .unwrap_or_else(|| default_commitment(node_id)))\n    }\n\n    fn node_entries(\n        \u0026self,\n        range: Range\u003cNodeId\u003e,\n    ) -\u003e Result\u003cVec\u003c(NodeId, CommitmentBytes)\u003e, Self::Error\u003e {\n        Ok(self.trie.read().unwrap().range(range).map(|(k, v)| (*k, *v)).collect())\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::account::{account_plain_key, storage_plain_key};\n    use alloy_consensus::constants::KECCAK_EMPTY;\n    use alloy_primitives::{map::HashMap as PrimitivesHashMap, Address, B256, U256};\n    use revm_database::{states::StorageSlot, AccountStatus, StorageWithOriginalValues};\n    use revm_state::AccountInfo;\n    use salt::{EphemeralSaltState, StateRoot};\n    use tempfile::TempDir;\n\n    fn make_bundle(accounts: Vec\u003c(Address, Vec\u003c(B256, U256)\u003e)\u003e) -\u003e revm_database::BundleState {\n        let mut state = PrimitivesHashMap::default();\n        for (addr, slots) in accounts {\n            let info = AccountInfo {\n                nonce: 1,\n                balance: U256::from(1000u64),\n                code_hash: KECCAK_EMPTY,\n                account_id: None,\n                code: None,\n            };\n            let mut storage = StorageWithOriginalValues::default();\n            for (slot, val) in slots {\n                storage.insert(slot.into(), StorageSlot::new_changed(U256::ONE, val));\n            }\n            state.insert(\n                addr,\n                revm_database::BundleAccount {\n                    info: Some(info),\n                    original_info: None,\n                    status: AccountStatus::Changed,\n                    storage,\n                },\n            );\n        }\n        revm_database::BundleState {\n            state,\n            contracts: Default::default(),\n            reverts: Default::default(),\n            state_size: 0,\n            reverts_size: 0,\n        }\n    }\n\n    /// Basic read/write round-trip.\n    #[test]\n    fn test_basic_read_write() {\n        let tmp = TempDir::new().unwrap();\n        let store = AsyncRocksStore::new(tmp.path()).unwrap();\n\n        let addr = Address::from([0xAB; 20]);\n        let slot = B256::from([0x01; 32]);\n        let bundle = make_bundle(vec![(addr, vec![(slot, U256::from(42u64))])]);\n\n        let kvs = crate::convert::bundle_state_to_plain_kv(\u0026bundle);\n        let mut eph = EphemeralSaltState::new(\u0026store);\n        let state_updates = eph.update_fin(\u0026kvs).unwrap();\n        store.update_state(state_updates).unwrap();\n\n        // Verify in-memory read.\n        let acct_key = account_plain_key(\u0026addr);\n        let state = store.state.read().unwrap();\n        assert!(!state.kvs.is_empty(), \"state should have entries after update\");\n        drop(state);\n    }\n\n    /// Cold start: write data, flush, create new instance, verify reads.\n    #[test]\n    fn test_cold_start_recovery() {\n        let tmp = TempDir::new().unwrap();\n\n        let addr = Address::from([0xCD; 20]);\n        let slot = B256::from([0x02; 32]);\n        let bundle = make_bundle(vec![(addr, vec![(slot, U256::from(99u64))])]);\n\n        // Write data and flush.\n        {\n            let store = AsyncRocksStore::new(tmp.path()).unwrap();\n            let kvs = crate::convert::bundle_state_to_plain_kv(\u0026bundle);\n            let mut eph = EphemeralSaltState::new(\u0026store);\n            let state_updates = eph.update_fin(\u0026kvs).unwrap();\n            store.update_state(state_updates.clone()).unwrap();\n\n            let mut root_engine = StateRoot::new(\u0026store);\n            let (_root_bytes, trie_updates) = root_engine.update_fin(\u0026state_updates).unwrap();\n            store.update_trie(trie_updates).unwrap();\n\n            // Flush ensures all writes are persisted before drop.\n            store.flush();\n        }\n\n        // Create new instance — should load state from RocksDB.\n        {\n            let store = AsyncRocksStore::new(tmp.path()).unwrap();\n            let state = store.state.read().unwrap();\n            assert!(!state.kvs.is_empty(), \"cold-start should load state from RocksDB\");\n            drop(state);\n\n            let trie = store.trie.read().unwrap();\n            assert!(!trie.is_empty(), \"cold-start should load trie from RocksDB\");\n        }\n    }\n\n    /// Verify that the full pipeline produces a non-zero root and that state roots\n    /// match between AsyncRocksStore and a fresh computation.\n    #[test]\n    fn test_full_pipeline() {\n        let tmp = TempDir::new().unwrap();\n        let store = AsyncRocksStore::new(tmp.path()).unwrap();\n\n        let addr = Address::from([0x11; 20]);\n        let slot = B256::from([0x22; 32]);\n        let bundle = make_bundle(vec![(addr, vec![(slot, U256::from(99u64))])]);\n\n        let kvs = crate::convert::bundle_state_to_plain_kv(\u0026bundle);\n        let mut eph = EphemeralSaltState::new(\u0026store);\n        let state_updates = eph.update_fin(\u0026kvs).unwrap();\n        store.update_state(state_updates.clone()).unwrap();\n\n        let mut root_engine = StateRoot::new(\u0026store);\n        let (root_bytes, trie_updates) = root_engine.update_fin(\u0026state_updates).unwrap();\n        store.update_trie(trie_updates).unwrap();\n\n        let root = B256::from(root_bytes);\n        assert_ne!(root, B256::ZERO, \"state root must be non-zero\");\n    }\n\n    /// Verify plain_value_fast works after flush + cold start.\n    #[test]\n    fn test_plain_value_fast() {\n        let tmp = TempDir::new().unwrap();\n\n        let addr = Address::from([0xEE; 20]);\n        let slot = B256::from([0x03; 32]);\n        let bundle = make_bundle(vec![(addr, vec![(slot, U256::from(7u64))])]);\n\n        {\n            let store = AsyncRocksStore::new(tmp.path()).unwrap();\n            let kvs = crate::convert::bundle_state_to_plain_kv(\u0026bundle);\n            let mut eph = EphemeralSaltState::new(\u0026store);\n            let state_updates = eph.update_fin(\u0026kvs).unwrap();\n            store.update_state(state_updates).unwrap();\n            store.flush();\n        }\n\n        // Reopen — CF_INDEX should be populated from the background write.\n        {\n            let store = AsyncRocksStore::new(tmp.path()).unwrap();\n            let acct_key = account_plain_key(\u0026addr);\n            let salt_key = store\n                .plain_value_fast(\u0026acct_key)\n                .expect(\"account plain_key must be in CF_INDEX after flush + reopen\");\n            let val = store.value(salt_key).unwrap().expect(\"SaltKey must exist\");\n            assert_eq!(val.key(), acct_key.as_slice());\n\n            let storage_key = storage_plain_key(\u0026addr, \u0026slot);\n            let salt_key_s = store\n                .plain_value_fast(\u0026storage_key)\n                .expect(\"storage plain_key must be in CF_INDEX\");\n            let val_s = store.value(salt_key_s).unwrap().expect(\"SaltKey must exist\");\n            assert_eq!(val_s.key(), storage_key.as_slice());\n\n            // Unknown key → error.\n            let unknown = account_plain_key(\u0026Address::from([0xFF; 20]));\n            assert!(store.plain_value_fa